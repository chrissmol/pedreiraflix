{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PedreiraFlix",
  "version": "1.0.0",
  "identifier": "com.pedreiraflix.app",
  "build": {
    "frontendDist": "https://pedreiraflix.chrisouzamol.workers.dev",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PedreiraFlix",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#06070c",
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36 Edg/141.0.0.0 PedreiraFlixDesktop"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "PedreiraFlix",
    "shortDescription": "Player IPTV",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["PortugueseBR"] }
    }
  }
}
