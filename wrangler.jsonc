{
  "name": "pedreiraflix",
  "main": "worker/index.js",
  "compatibility_date": "2026-01-01",
  // "Times favoritos": the Mol TV API Worker (same Cloudflare account), reached via /api/moltv/*.
  "services": [{ "binding": "MOLTV", "service": "mol-tv-api" }],
  // Suporte: feedbacks dos amigos (/api/feedback). Sem id de proposito: o `wrangler deploy` cria o namespace sozinho
  // na primeira vez (provisionamento automatico) e reaproveita depois.
  "kv_namespaces": [{ "binding": "FEEDBACK" }],
  // Favoritos e progresso entre aparelhos (/api/sync). Mesmo esquema do KV: o deploy cria o banco D1 sozinho, e a
  // tabela e criada pelo proprio Worker na primeira chamada.
  "d1_databases": [{ "binding": "SYNC", "database_name": "pedreiraflix-sync" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Was ["/api/*"] only: Cloudflare's edge served static assets straight from cache without ever
    // running worker/index.js, so the security headers set there (CSP etc.) silently never applied to
    // the actual site — only to /api/* responses. Routing everything through the Worker costs a
    // negligible bit of CPU per asset request in exchange for those headers actually landing.
    "run_worker_first": true
  }
}
