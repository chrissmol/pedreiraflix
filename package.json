{
  "name": "player",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,yellow \"vite\" \"nodemon server/index.js\"",
    "dev:web": "vite",
    "dev:api": "nodemon server/index.js",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "test:e2e": "playwright test",
    "mock": "node e2e/mock-xtream.mjs",
    "claude-worker": "node tools/claude-worker/worker.ts",
    "test:proxy": "node --test worker/*.test.mjs tests/*.test.mjs",
    "test:worker": "node --test tools/claude-worker/*.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "hls.js": "^1.7.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hls.js": "^0.13.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "ffmpeg-static": "^5.3.0",
    "nodemon": "^3.1.14",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.137.0"
  }
}
