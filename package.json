{
  "name": "pedreiraflix",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,yellow \"vite\" \"node --watch server/index.js\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "test:e2e": "playwright test",
    "mock": "node e2e/mock-xtream.mjs",
    "claude-worker": "node tools/claude-worker/worker.ts",
    "test:proxy": "node --test tests/worker/*.test.mjs tests/*.test.mjs",
    "test:worker": "node --test tools/claude-worker/*.test.ts",
    "testar-tudo": "node scripts/testar-tudo.mjs",
    "checar-producao": "node scripts/checar-producao.mjs",
    "estressar-web": "node scripts/estressar-web.mjs",
    "medir-desempenho": "node scripts/medir-desempenho.mjs",
    "simular-tv": "node scripts/simular-tv.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.5.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "hls.js": "^1.7.4",
    "qrcode-generator": "^1.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@csstools/postcss-cascade-layers": "^6.0.2",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "ffmpeg-static": "^5.3.0",
    "oxlint": "^1.92.0",
    "postcss-logical": "^8.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  }
}
